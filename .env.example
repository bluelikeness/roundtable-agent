# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.
POSTGRES_USER=multibot
# 허브 DB 주소(URL)에 그대로 들어가므로 영문·숫자·-·_ 만 쓴다
POSTGRES_PASSWORD=change-me
POSTGRES_DB=multibot

# 세션 쿠키 서명 키. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
HUB_SECRET_KEY=change-me
# 로컬 http 개발은 false, 운영(TLS)은 true
HUB_COOKIE_SECURE=false

# 허브↔어댑터 공유 토큰(X-Hub-Token). compose secret 으로 어댑터에 주입된다
# 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_ADAPTER_TOKEN=change-me

# 휴대폰 워커 기기 토큰(폰 게이트웨이 /phone/ws, docs/proposals/phone-worker.md 4장). 워커 앱 설정에 같은 값을 넣는다
# 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_DEVICE_TOKEN=change-me
# 폰 게이트웨이: 워커가 깨운 화면을 다 쓴 뒤 끄기까지 초(0 이면 끄지 않음). 보안 잠금이 없는 휴대폰에만 해당
PHONE_SCREEN_OFF_AFTER_S=30

# 공개 입구(edge, Caddy): 고정 주소로 허브를 열 때만. 공유기에서 바깥 TCP 443 → 이 PC 로 넘긴다.
# PUBLIC_HOST=hub.example.com
# COMPOSE_PROFILES=public
