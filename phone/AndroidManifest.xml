<?xml version="1.0" encoding="utf-8"?>
<!-- 멀티봇 워커 (docs/proposals/phone-worker.md). 휴대폰의 봇 앱(Vooy·피클·뮤즈)을 접근성 서비스로 조종하고
     허브의 폰 게이트웨이(wss://…/phone/ws)에 바깥으로 연결한다. 봇은 모르고 범용 명령만 수행한다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.multibot.worker"
    android:versionCode="3"
    android:versionName="0.3">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 질문을 처리하는 동안(화면 명령 뒤 2분) 화면이 꺼지지 않게 한다 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 연결 유지(KeepAlive 포그라운드 서비스). 백그라운드 앱은 삼성 등에서 네트워크가 끊긴다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 자동 업데이트(Updater): 자기 자신의 새 APK 를 PackageInstaller 로 설치한다 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 안드로이드 14+: 확인 없이 자기 업데이트(USER_ACTION_NOT_REQUIRED)를 하려면 필요하다 -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- 런처 인텐트로 봇 앱을 열기 위해 런처 앱 목록을 본다 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="멀티봇 워커"
        android:icon="@android:drawable/ic_menu_share"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 화면 깨우기(명령 wake): 잠금화면 위에 잠깐 뜨는 투명 화면. 보안 잠금은 넘기지 않는다 -->
        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <service
            android:name=".KeepAlive"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="허브(사용자 본인 서버)와 연결을 유지해 사용자 요청 시 봇 앱을 조종" />
        </service>

        <service
            android:name=".NotifListener"
            android:exported="true"
            android:label="멀티봇 워커 알림"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".A11y"
            android:exported="true"
            android:label="멀티봇 워커"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y" />
        </service>
    </application>
</manifest>
